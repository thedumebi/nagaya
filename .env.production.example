# nagaya's own secrets. The real file is .env.production, encrypted with
# dotenvx and committed; .env.keys (the decryption key) lives only on the box
# and on your laptop. DEPLOY.md §3.1 walks through creating it.

# Postgres superuser. Only nagaya uses it (creating roles, backups, restores);
# no app ever logs in as postgres.
PG_SUPERUSER_PASSWORD=

# Must equal REDIS_PASSWORD in ofuma/backend/.env.production AND .env.staging,
# and in doca/api's two env files. nagaya checks this on every deploy.
REDIS_PASSWORD_OFUMA=

# One R2 API token with Object Read & Write on dmb-backups and ofuma-backups.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Classic PAT with read:packages only, so the box can pull private images.
GHCR_USER=thedumebi
GHCR_TOKEN=

# Copied from nihongo's CRON_SECRET; sent as x-cron-secret by the reminders cron.
NIHONGO_CRON_SECRET=

# Brevo transactional API key: the same one the futari apps use. Sends the
# box-health emails from `nagaya alerts` (sites.yaml → alerts:).
BREVO_API_KEY=
