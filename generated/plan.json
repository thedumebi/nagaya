  "crons": [
    {
      "id": "futari-nihongo-reminders",
      "at": "*/15 * * * *",
      "container": "futari-nihongo-backend",
      "port": 3008,
      "path": "/notifications/run-reminders",
      "secretHeader": {
        "name": "x-cron-secret",
        "env": "NIHONGO_CRON_SECRET"
      }
    }
  ],
  "alerts": {
    "to": [
      "chiwuzohdaniel@gmail.com"
    ],
    "from": "nagaya@futari.live",
    "checks": {
      "memory": {
        "every": "*/5 * * * *",
        "repeatHours": 6,
        "thresholds": {
          "memAvailableMb": 400,
          "swapPagesPerSec": 100,
          "psiSomeAvg300": 10,
          "diskUsedPct": 85
        }
      },
      "cloudflareRanges": {
        "every": "7 6 * * *"
      }
    }
  },
  "backups": {
    "databases": [
      {
        "name": "dmb",
        "resource": "pg-main",
        "bucket": "dmb-backups"
      },
      {
        "name": "abm",
        "resource": "pg-main",
        "bucket": "dmb-backups"
      },
      {
        "name": "nihongo",
        "resource": "pg-main",
