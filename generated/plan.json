{
  "root": "/srv/nagaya",
  "resources": {
    "postgres": [
      "pg-main"
    ],
    "redis": [
      {
        "name": "redis-futari",
        "passwordEnv": null
      },
      {
        "name": "redis-ofuma",
        "passwordEnv": "REDIS_PASSWORD_OFUMA"
      }
    ]
  },
  "projects": [
    {
      "id": "futari-dmb",
      "app": "futari",
      "site": "dmb",
      "variant": "prod",
      "repo": "thedumebi/dmb.futari",
      "compose": "generated/compose/futari-dmb.yml",
      "network": "futari-dmb",
      "ownsNetwork": true,
      "attach": [
        {
          "container": "pg-main",
          "aliases": [
            "postgres",
            "dmb-postgres"
          ]
        },
        {
          "container": "redis-futari",
          "aliases": [
            "redis",
            "dmb-redis"
          ]
        }
      ],
      "database": {
        "name": "dmb",
        "resource": "pg-main"
      },
      "redis": {
        "resource": "redis-futari",
        "passwordEnv": null
      },
      "services": [
        {
          "key": "backend",
          "container": "futari-dmb-backend",
          "image": "ghcr.io/thedumebi/futari-dmb-backend",
          "port": 3006,
          "health": "/healthcheck",
          "nodeEnv": "production",
          "dotenvx": {
            "path": "/app/dmb/backend/.env.production",
            "keyName": "futari-dmb-backend",
            "keyFile": "/srv/nagaya/keys/futari-dmb-backend.production.key"
          },
          "credentials": {
            "pgUser": "PG_USERNAME",
            "pgPassword": "PG_PASSWORD",
            "pgDatabase": "PG_DATABASE",
            "redisPassword": null
          }
        },
        {
          "key": "frontend",
          "container": "futari-dmb-frontend",
          "image": "ghcr.io/thedumebi/futari-dmb-frontend",
          "port": 8080,
          "health": null,
          "nodeEnv": "production",
          "dotenvx": null,
          "credentials": null
        }
      ]
    },
