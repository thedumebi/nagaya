  "routes": [
    {
      "host": "futari.live",
      "project": null,
      "variant": "prod",
      "kind": "static"
    },
    {
      "host": "www.futari.live",
      "project": null,
      "variant": "prod",
      "kind": "redirect"
    },
    {
      "host": "dmb.futari.live",
      "project": "futari-dmb",
      "variant": "prod",
      "kind": "proxy"
    },
    {
      "host": "abm.futari.live",
      "project": "futari-abm",
      "variant": "prod",
      "kind": "proxy"
